{
  "$description": "Gruvbox light: the roles colors/gruvbox.vim gives the palette when background=light (faded accents, dark foregrounds), plus the window chrome, card edges and shadow ufsm needs.",
  "palette": {
    "$type": "color",
    "bg0Hard": { "$value": "{gruvbox.light0_hard}" },
    "bg0Medium": { "$value": "{gruvbox.light0}" },
    "bg0Soft": { "$value": "{gruvbox.light0_soft}" },
    "bg1": { "$value": "{gruvbox.light1}" },
    "bg2": { "$value": "{gruvbox.light2}" },
    "bg3": { "$value": "{gruvbox.light3}" },
    "bg4": { "$value": "{gruvbox.light4}" },
    "deepHard": { "$value": "{palette.bg1}", "$description": "Around the sheet, fields, text on accents: darker than bg0, as paper on a desk" },
    "deepMedium": { "$value": "{palette.bg1}" },
    "deepSoft": { "$value": "{palette.bg1}" },
    "gridHard": { "$value": "{gruvbox.light0_soft}", "$description": "Grid dots: one step darker than bg0" },
    "gridMedium": { "$value": "{gruvbox.light0_soft}" },
    "gridSoft": { "$value": "{gruvbox.light1}" },
    "fg0": { "$value": "{gruvbox.dark0}" },
    "fg1": { "$value": "{gruvbox.dark1}" },
    "fg2": { "$value": "{gruvbox.dark2}" },
    "fg3": { "$value": "{gruvbox.dark3}" },
    "fg4": { "$value": "{gruvbox.dark4}" },
    "gray": { "$value": "{gruvbox.gray_244}" },
    "red": { "$value": "{gruvbox.faded_red}" },
    "green": { "$value": "{gruvbox.faded_green}" },
    "yellow": { "$value": "{gruvbox.faded_yellow}" },
    "blue": { "$value": "{gruvbox.faded_blue}" },
    "purple": { "$value": "{gruvbox.faded_purple}" },
    "aqua": { "$value": "{gruvbox.faded_aqua}" },
    "orange": { "$value": "{gruvbox.faded_orange}" },
    "chrome": { "$value": "{palette.bg1}", "$description": "Window background around the cards" },
    "edge": { "$value": "{palette.bg2}", "$description": "Card edges: darker than both the card and the chrome" },
    "shadow": { "$value": { "colorSpace": "srgb", "components": [0.1569, 0.1569, 0.1569], "alpha": 0.2, "hex": "#282828" } }
  }
}
