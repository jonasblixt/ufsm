{
  "$description": "Gruvbox dark: the roles colors/gruvbox.vim gives the palette when background=dark (bright accents, light foregrounds), plus the window chrome, card edges and shadow ufsm needs.",
  "palette": {
    "$type": "color",
    "bg0Hard": { "$value": "{gruvbox.dark0_hard}" },
    "bg0Medium": { "$value": "{gruvbox.dark0}" },
    "bg0Soft": { "$value": "{gruvbox.dark0_soft}" },
    "bg1": { "$value": "{gruvbox.dark1}" },
    "bg2": { "$value": "{gruvbox.dark2}" },
    "bg3": { "$value": "{gruvbox.dark3}" },
    "bg4": { "$value": "{gruvbox.dark4}" },
    "deepHard": { "$value": "{palette.chrome}", "$description": "Around the sheet, fields, text on accents: darker than bg0" },
    "deepMedium": { "$value": "{gruvbox.dark0_hard}" },
    "deepSoft": { "$value": "{gruvbox.dark0}" },
    "gridHard": { "$value": "{gruvbox.dark0}", "$description": "Grid dots: one step lighter than bg0" },
    "gridMedium": { "$value": "{gruvbox.dark0_soft}" },
    "gridSoft": { "$value": "{gruvbox.dark1}" },
    "fg0": { "$value": "{gruvbox.light0}" },
    "fg1": { "$value": "{gruvbox.light1}" },
    "fg2": { "$value": "{gruvbox.light2}" },
    "fg3": { "$value": "{gruvbox.light3}" },
    "fg4": { "$value": "{gruvbox.light4}" },
    "gray": { "$value": "{gruvbox.gray_245}" },
    "red": { "$value": "{gruvbox.bright_red}" },
    "green": { "$value": "{gruvbox.bright_green}" },
    "yellow": { "$value": "{gruvbox.bright_yellow}" },
    "blue": { "$value": "{gruvbox.bright_blue}" },
    "purple": { "$value": "{gruvbox.bright_purple}" },
    "aqua": { "$value": "{gruvbox.bright_aqua}" },
    "orange": { "$value": "{gruvbox.bright_orange}" },
    "chrome": { "$value": { "colorSpace": "srgb", "components": [0.0784, 0.0863, 0.0902], "hex": "#141617" }, "$description": "Window background around the cards; darker than any gruvbox color" },
    "edge": { "$value": "{palette.bg1}", "$description": "Card edges: lighter than both the card and the chrome" },
    "shadow": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.45, "hex": "#000000" } }
  }
}
