        "label": { "x": 20, "y": 220, "w": 170 }
      },
      "t8": {
        "from": { "side": "top", "offset": 110 },
        "to": { "side": "bottom", "offset": 110 },
        "label": { "x": 290, "y": 240, "w": 200 }
      },
      "t9": {
        "from": { "side": "bottom", "offset": 10 },
        "to": { "side": "top", "offset": 360 },
        "label": { "x": 560, "y": 100, "w": 100 }
      },
      "t10": {
        "from": { "side": "top", "offset": 1030 },
