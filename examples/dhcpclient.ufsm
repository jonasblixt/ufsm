        "label": { "x": 1690, "y": 820, "w": 100 }
      },
      "t11": {
        "from": { "side": "top", "offset": 850 },
        "to": { "side": "bottom", "offset": 150 },
        "label": { "x": 1510, "y": 820, "w": 50 }
      },
      "t12": {
