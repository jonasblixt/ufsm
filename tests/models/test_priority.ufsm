        "label": { "x": 880, "y": 200, "w": 100 }
      },
      "t7": {
        "from": { "side": "right", "offset": 20 },
        "to": { "side": "left", "offset": 20 },
        "label": { "x": 580, "y": 120, "w": 100 }
      },
      "t8": {
        "from": { "side": "right", "offset": 38 },
