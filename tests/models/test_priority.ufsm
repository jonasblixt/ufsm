{
  "format": "ufsm",
  "version": 1,
  "name": "test_priority",
  "doc": "Transition priority (bug B1 regression). A transition out of a substate beats a conflicting one out of its ancestor; between transitions out of the same state, the first in the file wins.",
  "declarations": {
    "events": [
      { "id": "ev1", "name": "e1" },
      { "id": "ev2", "name": "e2" },
      { "id": "ev3", "name": "e3" },
      { "id": "ev4", "name": "e4" }
    ],
    "signals": [],
    "actions": [
      { "id": "act1", "name": "eP" },
      { "id": "act2", "name": "xP" },
      { "id": "act3", "name": "eC" },
      { "id": "act4", "name": "xC" },
      { "id": "act5", "name": "eX" },
      { "id": "act6", "name": "xX" },
      { "id": "act7", "name": "eY" },
      { "id": "act8", "name": "xY" },
      { "id": "act9", "name": "eZ" },
      { "id": "act10", "name": "xZ" }
    ],
    "guards": [{ "id": "grd1", "name": "g" }]
  },
  "machine": {
    "root": {
      "id": "r0",
      "name": "Root",
      "states": [
        { "id": "s1", "kind": "initial" },
        {
          "id": "s2",
          "kind": "state",
          "name": "P",
          "entry": [{ "call": "act1" }],
          "exit": [{ "call": "act2" }],
          "regions": [
            {
              "id": "r1",
              "name": "Pr1",
              "states": [
                { "id": "s3", "kind": "initial" },
                {
                  "id": "s4",
                  "kind": "state",
                  "name": "C",
                  "entry": [{ "call": "act3" }],
                  "exit": [{ "call": "act4" }]
                }
              ]
            }
          ]
        },
        {
          "id": "s5",
          "kind": "state",
          "name": "X",
          "entry": [{ "call": "act5" }],
          "exit": [{ "call": "act6" }]
        },
        {
          "id": "s6",
          "kind": "state",
          "name": "Y",
          "entry": [{ "call": "act7" }],
          "exit": [{ "call": "act8" }]
        },
        {
          "id": "s7",
          "kind": "state",
          "name": "Z",
          "entry": [{ "call": "act9" }],
          "exit": [{ "call": "act10" }]
        }
      ]
    },
    "transitions": [
      { "id": "t1", "from": "s1", "to": "s2" },
      { "id": "t2", "from": "s3", "to": "s4" },
      { "id": "t3", "from": "s2", "to": "s5", "on": "ev1" },
      { "id": "t4", "from": "s4", "to": "s6", "on": "ev1" },
      { "id": "t5", "from": "s4", "to": "s5", "on": "ev2" },
      { "id": "t6", "from": "s4", "to": "s7", "on": "ev2" },
      { "id": "t7", "from": "s4", "to": "s5", "on": "ev3", "guard": [{ "call": "grd1" }] },
      { "id": "t8", "from": "s4", "to": "s7", "on": "ev3" },
      { "id": "t9", "from": "s2", "to": "s5", "on": "ev4" }
    ]
  },
  "diagram": {
    "paper": "A4",
    "states": {
      "s1": { "x": 40, "y": 90, "w": 20, "h": 20 },
      "s2": { "x": 180, "y": 50, "w": 400, "h": 300 },
      "s3": { "x": 40, "y": 180, "w": 20, "h": 20 },
      "s4": { "x": 180, "y": 140, "w": 180, "h": 110 },
      "s5": { "x": 700, "y": 50, "w": 180, "h": 110 },
      "s6": { "x": 1000, "y": 50, "w": 180, "h": 110 },
      "s7": { "x": 1300, "y": 50, "w": 180, "h": 110 }
    },
    "regions": {},
    "transitions": {
      "t1": { "from": { "side": "right", "offset": 10 }, "to": { "side": "left", "offset": 20 } },
      "t2": { "from": { "side": "right", "offset": 10 }, "to": { "side": "left", "offset": 38 } },
      "t3": {
        "from": { "side": "right", "offset": 56 },
