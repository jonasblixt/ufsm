      "s8": { "x": 480, "y": 350, "w": 180, "h": 110 },
      "s9": { "x": 1000, "y": 50, "w": 180, "h": 110 }
    },
    "regions": { "r1": { "h": 210 } },
    "transitions": {
      "t1": { "from": { "side": "right", "offset": 10 }, "to": { "side": "left", "offset": 20 } },
      "t2": { "from": { "side": "right", "offset": 10 }, "to": { "side": "left", "offset": 38 } },
      "t3": { "from": { "side": "right", "offset": 10 }, "to": { "side": "left", "offset": 56 } },
      "t4": {
