    { "guards": { "ctrl": true }, "send": "eKey_plus", "expect": ["uiZoomIn"], "active": ["Tools", "Idle"], "doc": "Ctrl+plus (or Ctrl+=) zooms the whole window in." },
    { "send": "eKey_minus", "expect": ["uiZoomOut"], "doc": "Ctrl+minus zooms it out." },
    { "send": "eKey_0", "expect": ["uiZoomReset"], "doc": "Ctrl+0 goes back to 100%." },
