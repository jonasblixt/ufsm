    { "send": "eLMBUp", "expect": ["selectAtPointer"], "active": ["Idle"] },
    { "guards": { "ctrl": true }, "send": "eKey_p", "expect": ["quickOpen"], "active": ["Tools", "Idle"], "doc": "Ctrl+P opens the search (VS Code's Quick Open)." },
