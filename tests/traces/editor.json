    { "guards": { "beyondThreshold": true }, "send": "eMotion", "expect": ["lassoUpdate"], "active": ["Lasso"] },
    { "send": "eMotion", "expect": ["lassoUpdate"] },
    { "send": "eKey_esc", "expect": ["lassoCancel"], "active": ["Idle", "Tools"], "doc": "Escape cancels the rubber band only: the selection is cleared only when no rubber band is drawn (in-state guard on the configuration before the step)." },
    { "send": "eKey_esc", "expect": ["clearSelection", "closePanels"] },
    { "guards": { "beyondThreshold": false }, "send": "eLMBDown", "expect": ["pressStart"] },
    { "send": "eLMBUp", "expect": ["selectAtPointer"], "active": ["Idle"] },
    { "send": "eLMBDown", "expect": ["pressStart"] },
    { "guards": { "shift": true }, "send": "eLMBUp", "expect": ["toggleAtPointer"] },
    { "guards": { "shift": false, "beyondThreshold": true }, "send": "eLMBDown", "expect": ["pressStart"] },
    { "send": "eMotion", "expect": ["lassoUpdate"] },
    { "send": "eLMBUp", "expect": ["lassoFinish"], "active": ["Idle"] },
    { "send": "eLMBDown", "expect": ["pressStart"] },
    { "send": "eMotion", "expect": ["lassoUpdate"] },
    { "send": "eKey_z", "expect": ["hintZoom"], "active": ["Zoom", "Lasso"] },
    { "send": "eKey_esc", "expect": ["hintClear", "lassoCancel"], "active": ["Tools", "Idle"], "doc": "Both regions react: Zoom's exit action runs during the exit phase, then the transition actions." },
    { "send": "eLMBDown", "expect": ["pressStart"] },
    { "send": "eCancel", "expect": [], "active": ["Idle"] },
    { "send": "eRMBDown", "expect": ["panStart"], "active": ["PanPressed"] },
    { "send": "eMotion", "expect": ["panBegin", "panMove"], "active": ["Panning"] },
    { "send": "eMotion", "expect": ["panMove"] },
    { "send": "eWheel", "expect": ["zoomAtPointer"], "active": ["Panning"], "doc": "The wheel zooms while panning (right button held); the pan goes on from the new view." },
    { "send": "eMotion", "expect": ["panMove"], "active": ["Panning"] },
    { "send": "eRMBUp", "expect": ["panEnd"], "active": ["Idle"] },
    { "guards": { "beyondThreshold": false }, "send": "eRMBDown", "expect": ["panStart"] },
    { "send": "eWheel", "expect": ["zoomAtPointer"], "active": ["PanPressed"], "doc": "...and with the right button down before the pointer has moved." },
    { "send": "eMotion", "expect": [] },
    { "send": "eRMBUp", "expect": [], "active": ["Idle"], "doc": "A right click without moving does not pan." },
    { "guards": { "beyondThreshold": true }, "send": "eRMBDown", "expect": ["panStart"] },
    { "send": "eMotion", "expect": ["panBegin", "panMove"] },
    { "send": "eCancel", "expect": ["panEnd"], "active": ["Idle"] },
    { "send": "eWheel", "expect": ["zoomAtPointer"] },
    { "send": "eDoubleClick", "expect": ["openAtPointer"] },
    { "send": "eLMBDown", "expect": ["pressStart"] },
    { "send": "eWheel", "expect": [], "active": ["Pressed"], "doc": "The wheel only zooms while no button is held." },
    { "guards": { "pressedOnGrip": true }, "send": "eMotion", "expect": ["dragBegin", "dragUpdate"], "active": ["Dragging"], "inactive": ["Pressed", "Lasso"], "doc": "A press on a grip (an item, a handle or a label) drags instead of drawing a rubber band: the drag transition comes before the rubber band one in Pressed's list." },
    { "send": "eMotion", "expect": ["dragUpdate"], "active": ["Dragging"] },
    { "send": "eWheel", "expect": [], "doc": "No zooming during a drag." },
    { "guards": { "ctrl": true }, "send": "eKey_z", "expect": [], "active": ["Tools", "Dragging"], "doc": "No undo or redo while dragging (in-state guard)." },
    { "send": "eKey_r", "expect": [], "active": ["Tools", "Dragging"] },
    { "send": "eKey_n", "expect": [], "active": ["Tools", "Dragging"], "doc": "No new machine while dragging (Ctrl+n needs the pointer Idle)." },
    { "send": "eKey_esc", "expect": ["dragCancel"], "active": ["Tools", "Idle"], "doc": "Escape cancels the drag and keeps the selection (clearSelection is guarded by not in Dragging)." },
    { "send": "eKey_z", "expect": ["undo"] },
    { "send": "eKey_r", "expect": ["redo"], "active": ["Tools"], "doc": "Ctrl+r is redo, as in the old editor." },
    { "guards": { "ctrl": false }, "send": "eKey_r", "expect": [], "active": ["Tools"], "doc": "Plain r does nothing outside the jump mode." },
    { "send": "eMotion", "expect": ["hover"], "active": ["Idle"], "doc": "Moving without a button updates the cursor (a grip shows how it drags)." },
    { "send": "eLMBDown", "expect": ["pressStart"], "active": ["Pressed"] },
    { "send": "eMotion", "expect": ["dragBegin", "dragUpdate"], "active": ["Dragging"] },
    { "send": "eLMBUp", "expect": ["dragFinish"], "active": ["Idle"] },
    { "send": "eLMBDown", "expect": ["pressStart"] },
    { "send": "eMotion", "expect": ["dragBegin", "dragUpdate"] },
    { "send": "eCancel", "expect": ["dragCancel"], "active": ["Idle"], "doc": "Losing the pointer (pointercancel, window blur) cancels the drag." },
    { "guards": { "beyondThreshold": false }, "send": "eLMBDown", "expect": ["pressStart"] },
    { "send": "eMotion", "expect": [], "active": ["Pressed"], "doc": "A grip pressed but not moved past the threshold..." },
    { "send": "eLMBUp", "expect": ["selectAtPointer"], "active": ["Idle"], "doc": "...is a click." },
    { "guards": { "beyondThreshold": true, "pressedOnGrip": false }, "send": "eLMBDown", "expect": ["pressStart"] },
    { "send": "eMotion", "expect": ["lassoUpdate"], "active": ["Lasso"], "inactive": ["Dragging"], "doc": "Off a grip the rubber band is drawn as before." },
    { "send": "eLMBUp", "expect": ["lassoFinish"], "active": ["Idle"] },
    { "guards": { "ctrl": false }, "send": "eKey_p", "expect": ["togglePanel"], "doc": "p shows/hides the right panel (Properties, Project)." },
    { "guards": { "ctrl": true }, "send": "eKey_p", "expect": ["quickOpen"], "doc": "Ctrl+P opens the search field, not the panel." },
    { "send": "eKey_tab", "expect": ["nextTab"], "doc": "Ctrl+Tab: next machine tab." },
    { "guards": { "shift": true }, "send": "eKey_tab", "expect": ["prevTab"], "doc": "Ctrl+Shift+Tab: previous tab." },
    { "guards": { "ctrl": false, "shift": false }, "send": "eKey_tab", "expect": [], "doc": "Plain Tab does nothing." },
    { "guards": { "beyondThreshold": false }, "send": "eLMBDown", "expect": ["pressStart"], "active": ["Pressed"] },
    { "guards": { "ctrl": true }, "send": "eKey_tab", "expect": [], "doc": "No tab switch while a button is held (Pointer not Idle)." },
    { "guards": { "ctrl": false }, "send": "eLMBUp", "expect": ["selectAtPointer"], "active": ["Idle"] },
    { "send": "eKey_z", "expect": ["hintZoom"], "active": ["Zoom"] },
    { "send": "eKey_p", "expect": [], "active": ["Zoom"], "doc": "Inside a two-key command p does nothing." },
    { "send": "eKey_esc", "expect": ["hintClear"], "active": ["Tools"] },
    { "send": "eKey_a", "expect": ["hintAdd"], "active": ["Add", "Select"], "doc": "E4. a s: arm the state tool. Add's keys are internal transitions that emit the tool signal and sDone." },
    { "send": "eKey_s", "expect": ["toolState", "showTool", "hintClear"], "active": ["Tools", "Armed", "Place"], "inactive": ["Add", "Select"], "doc": "toolState, then the signals in order: sPlace (Select -> Armed/Place, entry showTool), sDone (Add -> Tools, exit hintClear)." },
    { "send": "eMotion", "expect": ["placeMove"], "active": ["Idle"], "doc": "With a placing tool, moving shows where it would go (not hover)." },
    { "send": "eKey_r", "expect": ["rotateTool"], "doc": "r turns a fork/join tool (ctrl is 0)." },
    { "send": "eLMBDown", "expect": ["placeStart"], "active": ["Sizing"], "inactive": ["Pressed"], "doc": "Idle -> Pressed is only for the select tool." },
    { "send": "eMotion", "expect": ["placeUpdate"] },
    { "send": "eLMBUp", "expect": ["placeFinish", "toolSelect"], "active": ["Idle", "Select"], "inactive": ["Armed", "Place"], "doc": "Placing is one-shot: ^sSelect disarms (Armed -> Select, entry toolSelect)." },
    { "send": "eKey_a", "expect": ["hintAdd"] },
    { "send": "eKey_f", "expect": ["toolFinal", "showTool", "hintClear"], "active": ["Place"], "doc": "a f: final state (f is fit only after z)." },
    { "send": "eLMBDown", "expect": ["placeStart"], "active": ["Sizing"] },
    { "send": "eCancel", "expect": ["placeCancel"], "active": ["Idle", "Place"], "doc": "Losing the pointer cancels the gesture; the tool stays armed." },
    { "send": "eLMBDown", "expect": ["placeStart"], "active": ["Sizing"] },
    { "send": "eKey_esc", "expect": ["placeCancel", "toolSelect"], "active": ["Idle", "Select", "Tools"], "doc": "Esc cancels the gesture (Pointer) and disarms (Tool) in one microstep: actions, then entries. Tools' Esc (clearSelection) needs Select, which was not active before the step." },
    { "guards": { "paletteConnect": true }, "send": "ePalette", "expect": ["paletteTool", "showTool"], "active": ["Connect"], "doc": "A palette click: the transition tool." },
    { "guards": { "validSource": false }, "send": "eLMBDown", "expect": ["linkRefuse"], "active": ["Idle", "Connect"], "doc": "Not on a vertex that can start a transition: say why, stay." },
    { "guards": { "validSource": true }, "send": "eLMBDown", "expect": ["linkStart"], "active": ["Linking"] },
    { "send": "eMotion", "expect": ["linkUpdate"] },
    { "send": "eWheel", "expect": ["zoomAtPointer"], "active": ["Linking"] },
    { "guards": { "beyondThreshold": false }, "send": "eLMBUp", "expect": [], "active": ["Linking"], "doc": "Released without dragging: click mode, the target comes with the next click." },
    { "guards": { "overVertex": false, "validTarget": false, "shift": false }, "send": "eLMBDown", "expect": ["linkBend"], "active": ["Linking"], "doc": "A click on empty canvas adds a bend point." },
    { "send": "eKey_backspace", "expect": ["linkUnbend"], "doc": "Backspace removes the last one (Tools' goUp needs Idle)." },
    { "send": "eMouseBack", "expect": [], "active": ["Linking"], "doc": "The mouse back button neither goes up nor removes a bend point while drawing (goUp needs Idle)." },
    { "guards": { "overVertex": true }, "send": "eLMBDown", "expect": ["linkRefuse"], "active": ["Linking"], "doc": "On a vertex that cannot be a target: say why, stay." },
    { "guards": { "validTarget": true, "shift": true }, "send": "eLMBDown", "expect": ["linkBend"], "active": ["Linking"], "doc": "Shift-click forces a bend point, even on a target." },
    { "send": "eLMBUp", "expect": [], "doc": "beyondThreshold is 0." },
    { "guards": { "shift": false }, "send": "eLMBDown", "expect": ["linkFinish", "toolSelect"], "active": ["Idle", "Select"], "doc": "A click on a valid target draws the transition and disarms." },
    { "send": "eLMBUp", "expect": [], "active": ["Idle"], "doc": "Its release arrives in Idle: nothing." },
    { "send": "eKey_a", "expect": ["hintAdd"] },
    { "send": "eKey_l", "expect": ["toolStraight", "showTool", "hintClear"], "active": ["Connect", "Tools"], "doc": "a l: the straight transition tool (a t is the S transition tool); both connect." },
    { "send": "eKey_esc", "expect": ["toolSelect"], "active": ["Select", "Tools"], "doc": "Esc disarms it." },
    { "send": "eKey_a", "expect": ["hintAdd"] },
    { "send": "eKey_t", "expect": ["toolTransition", "showTool", "hintClear"], "active": ["Connect", "Tools"], "doc": "a t: the transition tool." },
    { "send": "eLMBDown", "expect": ["linkStart"], "active": ["Linking"] },
    { "guards": { "beyondThreshold": true }, "send": "eLMBUp", "expect": ["linkFinish", "toolSelect"], "active": ["Idle", "Select"], "doc": "Dragged from the source and released on a valid target." },
    { "send": "ePalette", "expect": ["paletteTool", "showTool"], "active": ["Connect"], "doc": "paletteConnect is still 1." },
    { "send": "eLMBDown", "expect": ["linkStart"], "active": ["Linking"] },
    { "guards": { "validTarget": false }, "send": "eLMBUp", "expect": [], "active": ["Linking"], "doc": "Dragged but released off a target: keep linking." },
    { "send": "ePalette", "expect": [], "active": ["Linking", "Connect"], "doc": "Palette clicks only act while the pointer is idle." },
    { "send": "eCancel", "expect": ["linkCancel"], "active": ["Idle", "Connect"] },
    { "send": "eLMBDown", "expect": ["linkStart"], "active": ["Linking"] },
    { "send": "eKey_esc", "expect": ["linkCancel", "toolSelect"], "active": ["Idle", "Select"] },
    { "guards": { "paletteConnect": false }, "send": "ePalette", "expect": ["paletteTool", "showTool"], "active": ["Place"], "doc": "Any other palette tool places a vertex." },
    { "send": "ePalette", "expect": ["paletteTool", "showTool"], "active": ["Place"], "doc": "Another one: Armed -sPlace-> Place leaves and re-enters Place." },
    { "guards": { "paletteSelect": true }, "send": "ePalette", "expect": ["toolSelect"], "active": ["Select"], "doc": "The select tool disarms." },
    { "send": "ePalette", "expect": [], "active": ["Select"], "doc": "Select again: no transition for sSelect in Select." },
    { "guards": { "paletteSelect": false, "beyondThreshold": false }, "send": "eLMBDown", "expect": ["pressStart"], "active": ["Pressed"] },
    { "send": "eKey_a", "expect": [], "active": ["Tools", "Pressed"], "doc": "No add mode while a button is held." },
    { "send": "eKey_delete", "expect": [], "doc": "Nor deleting..." },
    { "guards": { "ctrl": true }, "send": "eKey_v", "expect": [], "doc": "...or pasting." },
    { "guards": { "ctrl": false }, "send": "eLMBUp", "expect": ["selectAtPointer"], "active": ["Idle"] },
    { "send": "eKey_delete", "expect": ["deleteSelection"], "doc": "Delete: the selection, with everything that depends on it." },
    { "send": "eKey_c", "expect": [], "doc": "Plain c, x, v do nothing." },
    { "send": "eKey_x", "expect": [] },
    { "send": "eKey_v", "expect": [] },
    { "guards": { "ctrl": true }, "send": "eKey_c", "expect": ["copy"] },
    { "send": "eKey_x", "expect": ["cut"] },
    { "send": "eKey_v", "expect": ["paste"] },
    { "guards": { "ctrl": false, "singleState": true }, "send": "eKey_a", "expect": ["hintAdd"] },
    { "send": "eKey_r", "expect": ["addRegion", "hintClear"], "active": ["Tools", "Select"], "doc": "a r with one state selected adds a region to it at once." },
    { "guards": { "singleState": false }, "send": "eKey_a", "expect": ["hintAdd"] },
    { "send": "eKey_r", "expect": ["toolRegion", "showTool", "hintClear"], "active": ["Place"], "doc": "Without one it arms the region tool (click a state)." },
    { "send": "eKey_a", "expect": ["hintAdd"], "doc": "a works while a tool is armed: it switches tools." },
    { "send": "eKey_i", "expect": ["toolInitial", "showTool", "hintClear"], "active": ["Place"] },
    { "send": "eKey_a", "expect": ["hintAdd"] },
    { "send": "eKey_h", "expect": ["toolHistory", "showTool", "hintClear"] },
    { "send": "eKey_a", "expect": ["hintAdd"] },
    { "send": "eKey_H", "expect": ["toolDeepHistory", "showTool", "hintClear"] },
    { "send": "eKey_a", "expect": ["hintAdd"] },
    { "send": "eKey_F", "expect": ["toolFork", "showTool", "hintClear"] },
    { "send": "eKey_a", "expect": ["hintAdd"] },
    { "send": "eKey_T", "expect": ["toolTerminate", "showTool", "hintClear"] },
    { "send": "eKey_a", "expect": ["hintAdd"] },
    { "send": "eKey_j", "expect": ["toolJoin", "showTool", "hintClear"], "active": ["Place", "Tools"], "doc": "a j: join (j alone starts the jump mode)." },
    { "send": "eKey_j", "expect": ["hintJump"], "active": ["Jump", "Place"] },
    { "send": "eKey_r", "expect": ["hintClear", "goRoot"], "active": ["Tools", "Place"], "doc": "j r is the jump to the root; the tool's rotate key needs Tools active before the step." },
    { "send": "eKey_a", "expect": ["hintAdd"] },
    { "send": "eKey_t", "expect": ["toolTransition", "showTool", "hintClear"], "active": ["Connect"], "inactive": ["Place"], "doc": "Placing -> connecting: Armed -sConnect-> Connect." },
    { "send": "eKey_a", "expect": ["hintAdd"] },
    { "guards": { "singleTransition": false }, "send": "eKey_v", "expect": [], "active": ["Add"], "doc": "a v needs one selected transition." },
    { "guards": { "singleTransition": true }, "send": "eKey_v", "expect": ["addBendPoint", "hintClear"], "active": ["Tools", "Connect"], "doc": "a v adds a bend point to it; the armed tool is unaffected." },
