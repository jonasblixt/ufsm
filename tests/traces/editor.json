    { "send": "eKey_esc", "expect": ["clearSelection", "closePanels"], "doc": "A second Esc clears the selection." },
    { "guards": { "ctrl": false, "singleTransition": true }, "send": "eKey_e", "expect": ["hintEdit"], "active": ["Edit"], "inactive": ["Tools"], "doc": "E5. e starts the edit mode; its keys are internal transitions that emit sDone." },
    { "send": "eKey_t", "expect": ["editTrigger", "hintClear"], "active": ["Tools"], "doc": "e t: edit the selected transition's trigger, then back to Tools (sDone, exit hintClear)." },
    { "send": "eKey_e", "expect": ["hintEdit"] },
    { "guards": { "singleState": false }, "send": "eKey_n", "expect": [], "active": ["Edit"], "doc": "e n needs one selected state." },
    { "guards": { "singleState": true }, "send": "eKey_n", "expect": ["editName", "hintClear"], "active": ["Tools"] },
    { "send": "eKey_e", "expect": ["hintEdit"] },
    { "guards": { "singleBar": false }, "send": "eKey_r", "expect": [], "active": ["Edit", "Select"], "doc": "e r needs a selected fork or join (r is not redo or rotate here)." },
    { "guards": { "singleBar": true }, "send": "eKey_r", "expect": ["turnBar", "hintClear"] },
    { "send": "eKey_e", "expect": ["hintEdit"] },
    { "send": "eKey_O", "expect": ["toggleOffPage", "hintClear"], "doc": "e O: put a region of the selected state on a page of its own, or back." },
    { "send": "eKey_e", "expect": ["hintEdit"] },
    { "send": "eKey_esc", "expect": ["hintClear"], "active": ["Tools"], "doc": "Esc leaves the edit mode; the selection stays (Tools was not active before the step)." },
    { "send": "eKey_a", "expect": ["hintAdd"] },
    { "send": "eKey_e", "expect": ["addEntry", "hintClear"], "active": ["Tools"], "doc": "a e: add an entry action to the selected state." },
    { "send": "eKey_a", "expect": ["hintAdd"] },
    { "send": "eKey_x", "expect": ["addExit", "hintClear"], "doc": "a x: an exit action." },
    { "send": "eKey_a", "expect": ["hintAdd"] },
    { "send": "eKey_g", "expect": ["addGuard", "hintClear"], "doc": "a g: a guard term on the selected transition." },
    { "send": "eKey_a", "expect": ["hintAdd"] },
    { "send": "eKey_a", "expect": ["addAction", "hintClear"], "active": ["Tools"], "doc": "a a: an action on the selected transition." },
    { "guards": { "singleState": false, "singleTransition": false }, "send": "eKey_a", "expect": ["hintAdd"] },
    { "send": "eKey_e", "expect": [], "active": ["Add"], "doc": "Nothing selected: the add keys for lists do nothing." },
    { "send": "eKey_x", "expect": [], "active": ["Add"] },
    { "send": "eKey_esc", "expect": ["hintClear"], "active": ["Tools"] },
    { "send": "eKey_a", "expect": ["hintAdd"] },
    { "send": "eKey_g", "expect": ["toolFrame", "showTool", "hintClear"], "active": ["Tools", "Place"], "doc": "a g with no transition selected: the group frame tool (documentation only)." },
    { "send": "eKey_esc", "expect": ["toolSelect"], "active": ["Select"] },
    { "send": "eKey_a", "expect": ["hintAdd"] },
    { "send": "eKey_n", "expect": ["toolNote", "showTool", "hintClear"], "active": ["Tools", "Place"], "doc": "a n: the note tool." },
    { "send": "eKey_esc", "expect": ["toolSelect"], "active": ["Select"] },
    { "send": "eKey_a", "expect": ["hintAdd"] },
    { "send": "eKey_c", "expect": ["toolArrow", "showTool", "hintClear"], "active": ["Tools", "Connect"], "doc": "a c: the arrow tool, which draws like a transition." },
    { "send": "eKey_esc", "expect": ["toolSelect"], "active": ["Select"] },
    { "guards": { "beyondThreshold": false }, "send": "eLMBDown", "expect": ["pressStart"], "active": ["Pressed"] },
    { "send": "eKey_e", "expect": [], "active": ["Tools"], "doc": "No edit mode while a button is held." },
    { "send": "eLMBUp", "expect": ["selectAtPointer"], "active": ["Idle"] },
    { "guards": { "ctrl": true }, "send": "eKey_e", "expect": [], "active": ["Tools"], "doc": "Ctrl+E is not the edit mode." },
