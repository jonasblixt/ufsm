    { "guards": { "shift": false }, "send": "eKey_z", "expect": ["hintZoom"], "active": ["Zoom"] },
    { "send": "eKey_f5", "expect": [], "active": ["Zoom"], "doc": "Not inside a two-key command: the F5 transitions belong to Tools." },
    { "send": "eKey_esc", "expect": ["hintClear"], "active": ["Tools"] },
