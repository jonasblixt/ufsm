{
  "model": "../../apps/editor/src/fsm/editor.ufsm",
  "doc": "The editor's own interaction model (apps/editor/src/fsm/editor.ufsm): old editor key map, pointer handling. Region Keys is above region Pointer, region Tool below it.",
  "steps": [
    { "reset": true, "expect": ["toolSelect"], "active": ["Tools", "Idle", "Select"], "doc": "Region Tool (E4) starts in Select, whose entry action shows the select tool." },
    { "send": "eKey_o", "expect": ["openFile"] },
    { "send": "eKey_s", "expect": ["save"] },
    { "send": "eKey_S", "expect": ["saveAs"] },
    { "send": "eKey_n", "expect": ["toggleSidebar"] },
    { "guards": { "ctrl": true }, "send": "eKey_n", "expect": ["newModel"], "active": ["Tools", "Idle"], "doc": "Ctrl+n is File › New, not the sidebar." },
    { "guards": { "ctrl": false }, "send": "eKey_backspace", "expect": ["goUp"] },
    { "send": "eMouseBack", "expect": ["goUp"], "doc": "The mouse back button goes up one level, as Backspace does." },
    { "send": "eKey_enter", "expect": [], "doc": "Nothing to open: singleState is false." },
    { "guards": { "singleState": true }, "send": "eKey_enter", "expect": ["enterSelected"] },
    { "guards": { "singleState": false }, "send": "eKey_a", "expect": ["hintAdd"], "active": ["Add"], "inactive": ["Tools"], "doc": "Plain a starts the add mode (a + key)." },
    { "send": "eKey_esc", "expect": ["hintClear"], "active": ["Tools"], "doc": "Esc leaves it; the Tools Esc (clear selection) is not taken: Keys was in Add." },
