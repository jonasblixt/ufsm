    { "send": "eKey_z", "expect": ["undo"], "active": ["Tools"], "doc": "Ctrl+z is undo, not the zoom mode." },
    { "guards": { "ctrl": false }, "send": "eKey_z", "expect": ["hintZoom"], "active": ["Zoom"], "inactive": ["Tools"] },
    { "send": "eKey_s", "expect": [], "active": ["Zoom"], "doc": "Inside a two-key command other keys do nothing." },
    { "send": "eKey_f", "expect": ["hintClear", "fit"], "active": ["Tools"] },
    { "send": "eKey_z", "expect": ["hintZoom"] },
    { "send": "eKey_n", "expect": ["hintClear", "zoomNormal"], "doc": "z n: zoom 100% (n alone toggles the sidebar)." },
    { "send": "eKey_z", "expect": ["hintZoom"] },
    { "send": "eKey_esc", "expect": ["hintClear"], "active": ["Tools"] },
    { "send": "eKey_j", "expect": ["hintJump"], "active": ["Jump"] },
    { "send": "eKey_a", "expect": ["hintClear", "goUp"] },
    { "send": "eKey_j", "expect": ["hintJump"] },
    { "send": "eKey_r", "expect": ["hintClear", "goRoot"] },
    { "send": "eLMBDown", "expect": ["pressStart"], "active": ["Pressed"] },
